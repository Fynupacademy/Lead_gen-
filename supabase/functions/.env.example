# Secrets des Edge Functions. En local : copie en "supabase/functions/.env" pour `supabase functions serve --env-file`.
# En prod : `supabase secrets set --env-file supabase/functions/.env` (ne jamais commiter le fichier rempli).

# --- Google Cloud Console (console.cloud.google.com) ---
GOOGLE_API_KEY=
GOOGLE_CSE_ID=

# --- Anthropic (console.anthropic.com) ---
ANTHROPIC_API_KEY=

# --- Infomaniak SMTP (module d'envoi) ---
INFOMANIAK_EMAIL=pierrot@fynup-consulting.ch
INFOMANIAK_PASSWORD=
INFOMANIAK_SMTP_HOST=mail.infomaniak.com
INFOMANIAK_SMTP_PORT=587

# --- Lien vers la vidéo avatar générique ---
VIDEO_URL=

# --- Nom affiché comme expéditeur ---
SENDER_NAME=Pierre-Olivier - FynUp Consulting

# SUPABASE_URL et SUPABASE_SERVICE_ROLE_KEY sont injectées automatiquement par Supabase
# dans les Edge Functions déployées — pas besoin de les définir ici en prod.
# En local avec `supabase functions serve`, elles sont aussi injectées automatiquement.
